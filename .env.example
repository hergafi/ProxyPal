# Copy to .env and edit. Never commit .env — it holds real secrets.

# Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8790
GATEWAY_CONFIG=gateway_config.json
DB_PATH=gateway.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8790,http://127.0.0.1:8790

# Optional fixed access token. When empty, a random token is generated on first start
# and stored in data/.gateway_token. Every API call needs "Authorization: Bearer <token>"
# except /health. Opening http://127.0.0.1:8790/ from this machine hands the token to the
# browser once; the app keeps it in localStorage.
GATEWAY_TOKEN=
# Optional override for where the generated token is stored.
# GATEWAY_TOKEN_FILE=/path/to/.gateway_token

# Optional sandbox for the workspace feature (empty = any local folder).
# WORKSPACE_ROOT=C:/projects

# Logging
LOG_LEVEL=INFO