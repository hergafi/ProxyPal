# Copy to .env and edit. Never commit .env — it holds real secrets.

# Gateway
GATEWAY_HOST=127.0.0.1
GATEWAY_PORT=8790
GATEWAY_CONFIG=gateway_config.json
DB_PATH=gateway.db
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8790,http://127.0.0.1:8790

# Optional shared secret. When set, API calls need "Authorization: Bearer <token>".
# Leave empty for a purely local app. In Docker, open /app/?token=<token> once to store it.
GATEWAY_TOKEN=

# Optional sandbox for the workspace feature (empty = any local folder).
# WORKSPACE_ROOT=C:/projects

# Logging
LOG_LEVEL=INFO